# Set a token before exposing HTTP APIs outside your machine.
ARBOR_API_TOKEN=
# Optional database location, outside public/.
# ARBOR_DB=/absolute/path/arbor.sqlite

# Docker binds to localhost; choose a shared workspace access token above.
ARBOR_PORT=8787
# Bedrock short-term bearer API key (NOT an AWS STS session token).
# Replace when expired, then: docker compose up -d --force-recreate
ARBOR_LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
ARBOR_LLM_MODEL=
AWS_BEARER_TOKEN_BEDROCK=
# Alternative SigV4 authentication: use all three for temporary STS credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Automatically summarize after content/hierarchy edits once a model is configured.
ARBOR_AUTO_SUMMARIZE=true
ARBOR_SUMMARY_DEBOUNCE=15
# Maximum model output tokens per node, including JSON abstract + overview.
# Root=layer 1; layer 4 budget also applies to deeper nodes. Source text is untouched.
ARBOR_SUMMARY_TOKENS=256,512,768,1024

# OpenAI API alternative (API key, not a ChatGPT website login).
# Set ARBOR_LLM_PROVIDER=openai and ARBOR_LLM_MODEL to your API model ID.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
