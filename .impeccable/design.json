      "css": ".ds-icon-button{font-family:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:inline-flex;align-items:center;justify-content:center;border:0;background:none;width:30px;height:30px;border-radius:6px;color:var(--muted,#627169);font-size:17px;cursor:pointer}.ds-icon-button:hover{background:#e9eee6;color:var(--ink,#24342e)}.ds-icon-button:focus-visible{outline:3px solid var(--focus,#75a68b);outline-offset:3px;}",
      "refersTo": "button-icon"
    },
    {
      "name": "Text field",
      "kind": "input",
      "description": "A labeled white field with the shipped border and focus treatment.",
      "html": "<label class=\"ds-label\" for=\"ds-node-title\">Title</label><input class=\"ds-input\" id=\"ds-node-title\" value=\"Connection troubleshooting\">",
      "css": ".ds-label{font-family:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:block;font-size:12px;font-weight:600;color:var(--ink,#24342e);margin-bottom:5px}.ds-input{font-family:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;max-width:100%;border:1px solid var(--line,#dce2db);border-radius:7px;background:var(--panel,#fff);color:var(--ink,#24342e);padding:9px 11px;font-size:12px;line-height:1.55}.ds-input:focus{outline:2px solid #98b7a3;outline-offset:1px}",
      "refersTo": "input"
    },
    {
      "name": "Main navigation",
      "kind": "nav",
      "description": "Horizontal destinations with a sage current-page underline.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#workspace\" aria-current=\"page\">Workspace</a><a href=\"#lab\">Traversal Lab</a><a href=\"#settings\">API &amp; models</a></nav>",
      "css": ".ds-nav{font-family:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:flex;height:72px;gap:32px;background:var(--panel,#fff)}.ds-nav a{position:relative;display:flex;align-items:center;gap:8px;color:var(--muted,#627169);font-size:12px;font-weight:550;white-space:nowrap;text-decoration:none}.ds-nav a:hover{color:var(--ink,#24342e)}.ds-nav a[aria-current]{color:var(--accent,#23664b)}.ds-nav a[aria-current]:after{content:\"\";height:3px;background:var(--accent,#23664b);position:absolute;bottom:0;left:0;right:0;border-radius:3px 3px 0 0}.ds-nav a:focus-visible{outline:3px solid var(--focus,#75a68b);outline-offset:3px;}@media(max-width:680px){.ds-nav{gap:0;justify-content:space-between;height:45px}.ds-nav a{font-size:11px}}"
    },
    {
      "name": "Status labels",
      "kind": "chip",
      "description": "Informational sage and subdued labels; no invented hover action.",
      "html": "<span class=\"ds-pill\">Live API</span> <span class=\"ds-pill ds-subtle\">Optional</span>",
      "css": ".ds-pill{font-family:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:inline-flex;align-items:center;gap:6px;border:1px solid #c8ddca;border-radius:5px;padding:3px 7px;background:var(--accent-soft,#e9f3ec);color:var(--accent,#23664b);font-size:10px;font-weight:550;line-height:1.55;white-space:nowrap}.ds-pill.ds-subtle{background:var(--canvas,#f5f6f2);border-color:var(--line,#dce2db);color:var(--muted,#627169)}",
      "refersTo": "pill"
    },
    {
      "name": "Working panel",
      "kind": "card",
      "description": "A flat, bordered response container with a compact heading.",
      "html": "<section class=\"ds-panel\"><header class=\"ds-panel-heading\"><h2>Response</h2><span>Waiting for your first command</span></header><div class=\"ds-panel-body\">Send a command to inspect the returned content.</div></section>",
      "css": ".ds-panel{font-family:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;border:1px solid var(--line,#dce2db);border-radius:12px;overflow:hidden;background:var(--panel,#fff);color:var(--ink,#24342e);font-size:13px;line-height:1.55}.ds-panel-heading{min-height:55px;padding:9px 18px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;border-bottom:1px solid var(--line,#dce2db)}.ds-panel-heading h2{font-size:14px;font-weight:600;letter-spacing:-.15px;margin:0}.ds-panel-heading span{font-size:11px;color:var(--muted,#627169)}.ds-panel-body{padding:18px 22px;color:var(--muted,#627169)}",
      "refersTo": "panel"
    },
    {
      "name": "Knowledge node",
      "kind": "custom",
      "description": "The signature source node; selected, visited, and current variants mirror the application.",
      "html": "<button class=\"ds-node ds-selected\" aria-label=\"Check the connection, selected\"><span class=\"ds-node-symbol\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 3h8l4 4v14H6zM14 3v5h4M9 12h6M9 16h6\"/></svg></span><span class=\"ds-node-text\"><span class=\"ds-node-title\">Check the connection</span><span class=\"ds-node-meta\">step</span></span></button>",
      "css": ".ds-node{font-family:Inter,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:flex;align-items:center;gap:10px;width:224px;height:66px;padding:10px 12px;background:var(--panel,#fff);color:var(--ink,#24342e);border:1px solid #d4ded1;border-radius:9px;box-shadow:0 2px 3px #273b2910;text-align:left;cursor:grab;touch-action:none;user-select:none;transition:border-color .15s,box-shadow .15s}.ds-node:hover{border-color:#95b09b;box-shadow:0 3px 8px #273b2920}.ds-node.ds-selected{border-color:var(--accent,#23664b);box-shadow:0 0 0 2px #23664b20}.ds-node.ds-visited{background:#edf4ed;border-color:#a6c5a6}.ds-node.ds-current{background:#fff6e5;border-color:#b68533;box-shadow:0 0 0 2px #bf9a4820}.ds-node:focus-visible{outline:3px solid var(--focus,#75a68b);outline-offset:3px;}.ds-node-symbol{background:#f1f5ed;color:#567f5c;width:30px;height:30px;display:grid;place-items:center;border-radius:7px;flex-shrink:0}.ds-node-text{min-width:0;flex:1}.ds-node-title{font-size:14px;line-height:1.35;font-weight:550;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.ds-node-meta{font-size:11px;color:var(--muted,#627169);margin-top:3px}@media(prefers-reduced-motion:reduce){.ds-node{transition:none}}",
      "refersTo": "graph-node"
    }
  ],
  "narrative": {
    "northStar": "Visible hierarchy, exact sources",
    "overview": "Arbor is a calm operational workspace. Warm off-white surroundings, white working panels, restrained sage states, and fine rules keep the tree and source material in the foreground. The visual thesis is visible hierarchy with exact source instructions: interface chrome helps people locate and understand information without rewriting its meaning.\n\nThe interface is compact enough for repeated use, with a clear page heading and a more open source-reading area. The tree is the primary visual artifact. The workspace and Traversal Lab share the same material and controls while keeping editing and request inspection distinct. This record is extracted from the implemented PHP views and vanilla JavaScript interface; it does not claim a formal design certificate or a rendered accessibility audit.",
    "keyCharacteristics": [
      "Quiet, light surfaces with sage used for actions and selection.",
      "Visible hierarchy through panels, thin rules, and tree connections.",
      "Readable source content beside compact operational controls.",
      "Explicit labels for versions, origins, references, and request state.",
      "Small state transitions, with reduced motion support."
    ],
    "rules": [
      {
        "name": "The State Has Meaning Rule",
        "body": "Use sage for primary actions and selection, pale green for visited nodes, and pale amber for the current traversal position. Pair state color with text, a legend, or a visible control state.",
        "section": "colors"
      },
      {
        "name": "The Source Stays Legible Rule",
        "body": "Use proportional type for source reading and editing. Reserve monospace for paths, JSON, API names, and technical identifiers.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep working panels flat. Use the existing modest lift on tree nodes and stronger shadows only for transient overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the page purpose, selected version, and current working state visible.",
      "Do preserve the distinction between abstracts, original content, preserved sources, and explicit references.",
      "Do reuse the actual control, node, and panel corner tokens instead of applying one radius everywhere.",
      "Do keep the selected request visible in history and align its response with the traversal state.",
      "Do retain visible keyboard focus, accessible control labels, native dialog behavior, and reduced motion support.",
      "Do stack working regions at narrow widths and allow the graph itself to scroll."
    ],
    "donts": [
      "Don't add marketing heroes, decorative cards, or fabricated metrics to this operational workspace.",
      "Don't make source instructions look like automatically executed workflow decisions.",
      "Don't present lexical search, sample content, or fixtures as model output.",
      "Don't use graph repositioning to imply a hierarchy change; outline movement and graph layout have distinct effects.",
      "Don't use color alone to distinguish source provenance or request outcomes.",
      "Don't infer new accent families or replace the quiet panel system with gradients, heavy shadows, or ornamental surfaces."
    ]
  }
}
